    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
