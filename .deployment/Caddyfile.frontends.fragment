# Review fragment only: replace public/www blocks in the CAPTURED LIVE file.
# Never overwrite the full production file with this fragment.
saitena.com {
    encode zstd gzip
    reverse_proxy saitena-public-candidate:3000
}
www.saitena.com {
    redir https://saitena.com{uri} 301
}
portal.saitena.com {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    header Referrer-Policy no-referrer
    encode zstd gzip
    reverse_proxy saitena-portal-candidate:3000
}
# Preserve clients.saitena.com -> PHP2 and API/admin/infra unchanged.
# Automatic public HTTPS requires separately approved portal DNS first.
