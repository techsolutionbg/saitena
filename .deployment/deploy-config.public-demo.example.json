{
  "enabled": false,
  "release_mode": "public-demo",
  "image_repository": "ghcr.io/techsolutionbg/saitena/public",
  "public_url": "https://saitena.com/",
  "caddy_file": "/REQUIRES-APPROVED-LIVE-MOUNT-PATH/Caddyfile",
  "caddy_container": "tech-solution-caddy-1",
  "network": "tech-solution_default",
