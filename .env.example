# Копирайте в .env.local (или попълнете Вашия .env). Не добавяйте кавички около името.
# Имейл за контакт с клиентите.
SAITENA_CONTACT_EMAIL=

# Телефон: български формат с начална 0 или международен формат с + / 00.
# Българските номера автоматично се преобразуват към +359 за обаждане.
SAITENA_CONTACT_PHONE=

# Поставете готовата връзка за чат, копирана от Вашия Viber профил/бизнес акаунт.
# Поддържат се viber://... и HTTPS връзки към viber.me / viber.com.
SAITENA_VIBER_URL=

# Локалният Sanctum API за auth. В development се отказват отдалечени API адреси.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
# Локалният клиентски портал; production стойността се задава само при одобрен deployment.
NEXT_PUBLIC_CLIENT_AREA_URL=http://127.0.0.1:3001
